# Copy this file to .env. The defaults match docker-compose.yml (everything local).
# To move a service online, change only its lines below.

PORT=3001
NODE_ENV=development
# Public URL of the API (shown in Swagger)
PUBLIC_API_URL=http://localhost:3001

# --- MongoDB --------------------------------------------------------------
# Local replica set from docker-compose.yml. Hosted example:
# DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>/atlaslearn
DATABASE_URL=mongodb://localhost:27017/atlaslearn?replicaSet=rs0&directConnection=true

# --- Redis (verification codes, reset tokens) -----------------------------
# Hosted example: REDIS_URL=rediss://default:<password>@<host>:6379
REDIS_URL=redis://localhost:6379

# --- File storage: any S3-compatible service ------------------------------
# Local MinIO from docker-compose.yml (console: http://localhost:9001).
# AWS S3 example: S3_ENDPOINT=https://s3.eu-west-3.amazonaws.com, S3_REGION=eu-west-3,
#   S3_PUBLIC_URL=https://<bucket>.s3.eu-west-3.amazonaws.com, S3_AUTO_CREATE_BUCKET=false
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=atlaslearn
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# Base URL of the public links stored in the database
S3_PUBLIC_URL=http://localhost:9000/atlaslearn
# Create the bucket with public read access at startup (local MinIO only)
S3_AUTO_CREATE_BUCKET=true
MAX_UPLOAD_MB=500

# --- Auth -----------------------------------------------------------------
# Secret used to sign JWTs — use a long random string (same value in AtlasFront/.env.local)
JWT_SECRET=change-me

# --- Email (optional) -----------------------------------------------------
# Gmail account + app password. Leave empty to print emails in the API console.
EMAIL_USER=
EMAIL_PASS=
