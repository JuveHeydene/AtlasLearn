# Copy this file to .env.local.

# URL of the Express API (AtlasBack)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Must be the SAME value as JWT_SECRET in AtlasBack/.env:
# the Next.js middleware verifies the token to protect the dashboards.
JWT_SECRET=change-me

# Public URL of the file storage (MinIO locally) — same as S3_PUBLIC_URL in AtlasBack/.env
NEXT_PUBLIC_STORAGE_URL=http://localhost:9000/atlaslearn
